# ---- Kabadiwala Connect backend configuration ----
# Copy to `.env` and adjust. NEVER commit the real .env file.

APP_NAME="Kabadiwala Connect API"
ENV=development
DEBUG=true

# PostgreSQL (PostGIS enabled)
DATABASE_URL=postgresql+psycopg2://kabadiwala:kabadiwala_dev_pw@127.0.0.1:5432/kabadiwala_connect

# Auth — generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-please-use-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS — comma separated list of allowed origins for the two frontends
CORS_ORIGINS=http://localhost:12000,http://127.0.0.1:12000,http://localhost:12001,http://127.0.0.1:12001,http://localhost:5173,http://localhost:3000,http://localhost:3001

# AI/ML
# Optional: path to a fine-tuned material-classifier checkpoint (.pt).
# If unset, the classifier uses ImageNet-pretrained MobileNetV3 + the
# documented e-waste category map (transfer-learning head), which is a
# genuine model inference — not a mock.
MODEL_PATH=
# When MODEL_PATH is unset, allow downloading torchvision pretrained weights.
ALLOW_MODEL_DOWNLOAD=true
